#!/usr/bin/env groovy
library 'status-jenkins-lib@v1.9.52'

pipeline {
  agent {
    docker {
      label 'linuxcontainer'
      image 'harbor.status.im/infra/ci-build-containers:linux-base-1.0.0'
      args '--volume=/var/run/docker.sock:/var/run/docker.sock ' +
           '--user jenkins'
    }
  }

  options {
    timestamps()
    ansiColor('xterm')
    disableRestartFromStage()
    timeout(time: 30, unit: 'MINUTES')
    buildDiscarder(logRotator(
      numToKeepStr: '10',
      daysToKeepStr: '30',
    ))
  }

  environment {
    IMAGE_NAME          = 'harbor.status.im/logos-co/logos-node'
    DOCKER_CRED         = 'harbor-logos-co-logos-node'
    DOCKER_REGISTRY_URL = 'https://harbor.status.im'
  }

  stages {
    stage('Params') {
      steps { script {
        properties([parameters(moduleParams())])
      } }
    }

    stage('Build') {
      steps { script {
        def tag = params.IMAGE_TAG?.trim() ?: deployTag()
        image = docker.build(
          "${env.IMAGE_NAME}:${tag}",
          "${buildArgs()} ."
        )
      } }
    }

    stage('Check') {
      steps { script {
        image.inside('--entrypoint=""') {
          sh 'logosctl --version'
          sh 'logosctl package ls'
        }
      } }
    }

    stage('Push') {
      steps { script {
        withDockerRegistry([
          credentialsId: env.DOCKER_CRED, url: env.DOCKER_REGISTRY_URL
        ]) {
          image.push()
        }
      } }
    }
  }

  post {
    always { sh 'docker image prune -f' }
  }
}

def module() {
  def name = env.JOB_NAME
  if (name.contains('storage'))    return 'storage'
  if (name.contains('delivery'))   return 'delivery'
  if (name.contains('blockchain')) return 'blockchain'
  return 'logos'
}

def fleet() {
  def name = env.JOB_NAME
  if (name.contains('devnet'))  return 'dev'
  if (name.contains('testnet')) return 'test'
  return 'dev'
}

def deployTag() { return "deploy-${module()}-${fleet()}" }

def moduleParams() {
  def common = [
    string(name: 'IMAGE_TAG',           description: 'Custom image tag.',                              defaultValue: ''),
    string(name: 'OPENMETRICS_VERSION', description: 'Openmetrics module version. Empty to exclude.',  defaultValue: lastParam('OPENMETRICS_VERSION', '0.1.1')),
    string(name: 'MODULES_REPO',        description: 'Module catalog. Empty for default.',             defaultValue: ''),
  ]
  switch (module()) {
    case 'delivery':
      return common + [
        string(name: 'DELIVERY_VERSION', description: 'Delivery module version.',  defaultValue: lastParam('DELIVERY_VERSION', '0.3.0')),
        string(name: 'RLN_VERSION',      description: 'RLN module version.',       defaultValue: lastParam('RLN_VERSION', '')),
        string(name: 'LIBP2P_VERSION',   description: 'libp2p module version.',    defaultValue: lastParam('LIBP2P_VERSION', '')),
      ]
    case 'storage':
      return common + [
        string(name: 'STORAGE_VERSION', description: 'Storage module version.',    defaultValue: lastParam('STORAGE_VERSION', '2.1.3')),
      ]
    case 'blockchain':
      return common + [
        string(name: 'BLOCKCHAIN_VERSION', description: 'Blockchain module version.', defaultValue: lastParam('BLOCKCHAIN_VERSION', '0.2.4')),
      ]
    default: // testnet
      return common + [
        string(name: 'DELIVERY_VERSION',   description: 'Delivery module version.',   defaultValue: lastParam('DELIVERY_VERSION', '0.3.0')),
        string(name: 'STORAGE_VERSION',    description: 'Storage module version.',    defaultValue: lastParam('STORAGE_VERSION', '2.1.3')),
        string(name: 'BLOCKCHAIN_VERSION', description: 'Blockchain module version.', defaultValue: lastParam('BLOCKCHAIN_VERSION', '0.2.4')),
        string(name: 'RLN_VERSION',        description: 'RLN module version.',        defaultValue: lastParam('RLN_VERSION', '')),
        string(name: 'LIBP2P_VERSION',     description: 'libp2p module version.',     defaultValue: lastParam('LIBP2P_VERSION', '')),
      ]
  }
}

def buildArgs() {
  def args = "--label=build='${env.BUILD_URL}' --label=commit='${git.commit()}' "

  ['DELIVERY_VERSION', 'STORAGE_VERSION', 'BLOCKCHAIN_VERSION', 'OPENMETRICS_VERSION'].each {
    def val = params[it]?.trim() ?: ''
    args += "--build-arg ${it}='${val}' "
    if (val) {
      args += "--label=${it.replace('_VERSION','').toLowerCase()}='${val}' "
    }
  }

  if (params.RLN_VERSION?.trim()) {
    args += "--build-arg RLN_VERSION='${params.RLN_VERSION}' "
    args += "--label=rln='${params.RLN_VERSION}' "
  }
  if (params.LIBP2P_VERSION?.trim()) {
    args += "--build-arg LIBP2P_VERSION='${params.LIBP2P_VERSION}' "
    args += "--label=libp2p='${params.LIBP2P_VERSION}' "
  }
  if (params.MODULES_REPO?.trim()) {
    args += "--build-arg MODULES_REPO='${params.MODULES_REPO}' "
  }

  return args
}

def lastParam(name, fallback) {
  return params[name] ?: currentBuild.previousSuccessfulBuild?.getBuildVariables()?.get(name) ?: fallback
}