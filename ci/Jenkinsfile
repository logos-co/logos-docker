#!/usr/bin/env groovy
library 'status-jenkins-lib@v1.9.52'

pipeline {
  agent {
    docker {
      label 'linuxcontainer'
      image 'harbor.status.im/infra/ci-build-containers:linux-base-1.0.0'
      args '--volume=/var/run/docker.sock:/var/run/docker.sock ' +
           '--user jenkins'
    }
  }

  options {
    timestamps()
    ansiColor('xterm')
    disableRestartFromStage()
    timeout(time: 30, unit: 'MINUTES')
    buildDiscarder(logRotator(
      numToKeepStr: '10',
      daysToKeepStr: '30',
    ))
  }

  environment {
    IMAGE_NAME = 'harbor.status.im/logos-co/logos-node'
    DOCKER_CRED = 'harbor-logos-co-logos-node'
    DOCKER_REGISTRY_URL = 'https://harbor.status.im'
  }

  parameters {
    string(
      name: 'LOGOSCTL_VERSION',
      description: 'logosctl release. Leave empty for default.',
      defaultValue: ''
    )
    string(
      name: 'DELIVERY_VERSION',
      description: 'Delivery module version. Leave empty to exclude.',
      defaultValue: lastParam('DELIVERY_VERSION', '0.3.0')
    )
    string(
      name: 'STORAGE_VERSION',
      description: 'Storage module version. Leave empty to exclude.',
      defaultValue: lastParam('STORAGE_VERSION', '2.1.3')
    )
    string(
      name: 'BLOCKCHAIN_VERSION',
      description: 'Blockchain module version. Leave empty to exclude.',
      defaultValue: lastParam('BLOCKCHAIN_VERSION', '0.2.4')
    )
    string(
      name: 'RLN_VERSION',
      description: 'RLN module version. Leave empty to exclude.',
      defaultValue: lastParam('RLN_VERSION', '')
    )
    string(
      name: 'OPENMETRICS_VERSION',
      description: 'Openmetrics module version. Leave empty to exclude.',
      defaultValue: lastParam('OPENMETRICS_VERSION', '0.1.1')
    )
    string(
      name: 'MODULES_REPO',
      description: 'Module catalog. Leave empty for default.',
      defaultValue: ''
    )
    string(
      name: 'RLN_REPO',
      description: 'RLN module catalog. Leave empty for default.',
      defaultValue: ''
    )
  }

  stages {
    stage('Build') {
      steps { script {
        image = docker.build(
          "${env.IMAGE_NAME}:${deployTag()}",
          "${buildArgs()} ."
        )
      } }
    }

    stage('Check') {
      steps { script {
        image.inside('--entrypoint=""') {
          sh 'logosctl --version'
        }
      } }
    }

    stage('Push') {
      steps { script {
        withDockerRegistry([
          credentialsId: env.DOCKER_CRED, url: env.DOCKER_REGISTRY_URL
        ]) {
          image.push()
        }
      } }
    }
  }

  post {
    always { sh 'docker image prune -f' }
  }
}

def fleet() {
  if (env.JOB_NAME.contains('dev')) return 'dev'
  if (env.JOB_NAME.contains('test')) return 'test'
  return 'dev'
}

def deployTag() {
  return "deploy-logos-${fleet()}"
}

def lastParam(name, fallback) {
  return params[name] ?: currentBuild.previousSuccessfulBuild?.getBuildVariables()?.get(name) ?: fallback
}

def buildArgs() {
  def args = "--label=build='${env.BUILD_URL}' --label=commit='${git.commit()}' "

  ['DELIVERY_VERSION', 'STORAGE_VERSION', 'BLOCKCHAIN_VERSION', 'OPENMETRICS_VERSION'].each {
    args += "--build-arg ${it}='${params[it]?.trim() ?: ''}' "
    if (params[it]?.trim()) {
      args += "--label=${it.replace('_VERSION','').toLowerCase()}='${params[it]}' "
    }
  }

  if (params.RLN_VERSION?.trim()) {
    args += "--build-arg RLN_VERSION='${params.RLN_VERSION}' "
    args += "--label=rln='${params.RLN_VERSION}' "
  }
  if (params.LOGOSCTL_VERSION?.trim()) {
    args += "--build-arg LOGOSCTL_VERSION='${params.LOGOSCTL_VERSION}' "
    args += "--label=logosctl='${params.LOGOSCTL_VERSION}' "
  }
  if (params.MODULES_REPO?.trim()) {
    args += "--build-arg MODULES_REPO='${params.MODULES_REPO}' "
  }
  if (params.RLN_REPO?.trim()) {
    args += "--build-arg RLN_REPO='${params.RLN_REPO}' "
  }

  return args
}